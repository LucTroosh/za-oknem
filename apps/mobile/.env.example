# Copy relevant values into .env.local, or export them in your shell before
# running `expo start`. EXPO_PUBLIC_* vars are inlined into the JS bundle at
# build time — after changing one, restart with `expo start -c` (clears
# Metro's cache) and fully close + reopen Expo Go, not just reload, or you'll
# keep talking to the old value.

# Backend API base URL.
# - Web / iOS simulator: http://localhost:8000 (default — no need to set this)
# - Android emulator:    http://10.0.2.2:8000
# - Physical device:     http://<your-machine's-LAN-IP>:8000, e.g. http://192.168.1.42:8000
#   Find your LAN IP: `ipconfig getifaddr en0` (macOS Wi-Fi) or `hostname -I` (Linux).
#   Phone and computer must be on the same Wi-Fi network (not mobile data).
EXPO_PUBLIC_API_URL=http://localhost:8000
