# Copy to `.env.prod` on the VPS and fill in. NEVER commit `.env.prod`.
# Used by docker-compose.prod.yml (docs/release/vps-runbook.md).

# Public host name of the API (DNS A record -> the VPS). Caddy gets the HTTPS certificate for it.
API_DOMAIN=api.example.pl

# Database. The password MUST be changed (generate: `openssl rand -base64 32`, use URL-safe chars).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://za_oknem:change-me@postgres:5432/za_oknem

# Providers (ADR-022, ADR-031). Free API: leave the Open-Meteo URLs unset and the key empty.
# Commercial plan (REQUIRED before ads or paid/premium features - docs/release/business-gates.md):
#   OPEN_METEO_FORECAST_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
#   OPEN_METEO_AIR_QUALITY_BASE_URL=https://customer-air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_API_KEY=
# GIOS_STATION_IDS stays empty: ADR-025 (nearest stations with data, from the catalog).
GIOS_STATION_IDS=

# Backups (infrastructure/scripts/README.md): rclone remote + age public key.
BACKUP_REMOTE=
AGE_RECIPIENT=
