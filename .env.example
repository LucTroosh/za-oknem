DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/za_oknem
REDIS_URL=redis://redis:6379/0

# ADR-007: comma-separated GIOŚ station IDs the scheduler should poll hourly (override:
# exactly these stations). Empty (default) = ADR-025: the scheduler polls the nearest GIOŚ
# station (<= 50 km, deterministic) of every area with active polling, from a station
# catalog cached in the DB (refreshed daily); no areas / no station in range = GIOŚ skipped.
# Find IDs near you: `--list` in the README quickstart.
GIOS_STATION_IDS=

# TASK-1.1 (§68 backup): rclone destination + age public key for encrypting secrets
# before upload. See infrastructure/scripts/README.md. Empty until a real off-VPS
# destination is chosen (production decision, not required for local dev).
BACKUP_REMOTE=
AGE_RECIPIENT=

# ADR-022: Open-Meteo provider. Defaults = Free (non-commercial) hosts; leave empty/unset for MVP.
# Commercial plan (required BEFORE any monetization, ADR-003 checklist) = set ONLY these three
# (leave the two URLs unset for Free: an empty value would override the default with ""):
#   OPEN_METEO_FORECAST_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
#   OPEN_METEO_AIR_QUALITY_BASE_URL=https://customer-air-quality-api.open-meteo.com/v1/air-quality  (host: verify in customer panel)
# The key is a secret: environment / secret store only, never committed. Sent as `apikey` param.
OPEN_METEO_API_KEY=
# Daily Open-Meteo call cap used by the 70% alert (default 10000 = Free; raise with a paid plan):
# OPEN_METEO_DAILY_CALL_LIMIT=10000

# ADR-029: places registry (any locality). Local file of the GeoNames PL dump (PL.txt or PL.zip),
# imported by `python -m app.connectors.geonames_places.ingest` (or pass --file).
# GEONAMES_PL_FILE=/data/PL.zip
# Days without a fresh POST /places/{id}/activate after which a place stops being polled:
# PLACE_ACTIVATION_TTL_DAYS=7

# Behind Caddy (production): proxy address(es) trusted for X-Forwarded-For, NOT "*" (ADR-029, TASK-15.6)
# FORWARDED_ALLOW_IPS=
