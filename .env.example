DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/za_oknem
REDIS_URL=redis://redis:6379/0

# ADR-007: comma-separated GIOŚ station IDs the scheduler should poll hourly.
# Empty (default) = scheduler skips GIOŚ entirely, logs it, doesn't guess a
# station for you (rule #9). Find IDs near you: `--list` in the README quickstart.
GIOS_STATION_IDS=
